# Copy to .env and fill in values before running the backend.

# Port the Go server listens on (default: 8080)
PORT=8080

# Postgres connection string.
# Local dev: sslmode=disable is fine for a local container.
# Production (Neon): the connection string from the Neon dashboard already
#   includes sslmode=require — use it as-is. Do NOT use sslmode=disable
#   against Neon; TLS is required and connections will be refused without it.
DATABASE_URL=postgres://wordle:wordle@localhost:5432/wordle?sslmode=disable

# Allowed CORS origin for the frontend (default: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000
