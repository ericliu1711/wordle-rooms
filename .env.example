# Copy to .env and fill in values before running the backend.

# Port the Go server listens on (default: 8080)
PORT=8080

# Allowed CORS origin for the frontend (default: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Postgres connection string (not used yet — added in a future phase)
DATABASE_URL=postgres://wordle:wordle@localhost:5432/wordle?sslmode=disable
