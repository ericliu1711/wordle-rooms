# URL of the Go backend.
#
# Local dev: keep as-is and copy this file to .env.local.
# Production (Vercel): set NEXT_PUBLIC_API_URL in your Vercel project's
#   Environment Variables dashboard (Settings → Environment Variables).
#   Example: https://wordle-rooms-api.onrender.com
#
# This variable is baked into the client bundle at build time.
# If it is missing or still points to localhost, the app will throw
# loudly on load to surface the misconfiguration early.
NEXT_PUBLIC_API_URL=http://localhost:8080
